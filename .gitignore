# ============================================================
# Sky Eco-Travel Advisor — .gitignore
# ============================================================

# ---------- Gizli dosyalar (API anahtarlari) ----------
.env
!.env.example

# ---------- Python sanal ortam ----------
rasa-env/
venv/
.venv/
env/

# ---------- Python cache ----------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/

# ---------- Rasa model dosyalari (buyuk dosyalar) ----------
models/
*.tar.gz

# ---------- Rasa gecici dosyalar ----------
.rasa/
graph.html

# ---------- macOS sistem dosyalari ----------
.DS_Store
.AppleDouble
.LSOverride
._*

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Jupyter Notebook ----------
.ipynb_checkpoints/

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Odev dosyalari (GitHub'a yuklenmesine gerek yok) ----------
assignmentFile/
assignmentExamplePhotosFromTheClass/

# ---------- Test results (regenerated by rasa test) ----------
results/

# ---------- Temporary helper scripts ----------
_*.py

# ---------- Backup files ----------
*.bak*
data/nlu_backup.yml

# ---------- Test output logs ----------
test_*.txt

# ---------- Claude session outputs ----------
Claude outputs/

# ---------- Old API files from university ----------
apisFromUni/
