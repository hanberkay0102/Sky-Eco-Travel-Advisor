# ============================================================
# Sky Eco-Travel Advisor — Environment Variables
# ============================================================
# Copy this file to .env and replace placeholder values with your real API keys:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ============================================================

# Climatiq API — carbon emission calculations
# Get your key at: https://www.climatiq.io/
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# OpenRouteService API — distance/routing calculations
# Get your key at: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_ors_api_key_here
